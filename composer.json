{
    "name": "avvertix/dmarc-report-parser",
    "description": "Parse DMARC xml reports",
    "keywords": [
        "dmarc",
        "dmarc-report",
        "email",
        "parser"
    ],
    "homepage": "https://github.com/avvertix/dmarc-report-parser",
    "license": "MIT",
    "authors": [
        {
            "name": "Alessio Vertemati",
            "email": "avvertix@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "saloonphp/xml-wrangler": "^1.3",
        "symfony/mime": "^7.4.0 || ^8.0.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "symfony/var-dumper": "^7.4.0 || ^8.0.0"
    },
    "autoload": {
        "psr-4": {
            "Avvertix\\DmarcReportParser\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Avvertix\\DmarcReportParser\\Tests\\": "tests"
        }
    },
    "scripts": {

        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=90"
        ],
        "test:unit": [
            "vendor/bin/pest --no-coverage --parallel"
        ],
        "test-coverage": "vendor/bin/pest --coverage",
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
